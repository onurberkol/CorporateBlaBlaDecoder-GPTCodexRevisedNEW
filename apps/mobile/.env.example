# Firebase web config (safe to ship — these are public identifiers).
# EXPO_PUBLIC_ vars are inlined into the app at build time.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FUNCTIONS_REGION=europe-west1

# RevenueCat public SDK keys (one per platform)
EXPO_PUBLIC_RC_IOS=
EXPO_PUBLIC_RC_ANDROID=
