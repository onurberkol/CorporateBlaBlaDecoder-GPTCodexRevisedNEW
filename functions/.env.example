# Set the OpenAI key as a Firebase secret (not here):
#   firebase functions:secrets:set OPENAI_API_KEY
# AI_PROVIDER=openai is the launch default. An Anthropic adapter exists for
# controlled evals/fallback after its secret is configured and deployed.
AI_PROVIDER=openai
OPENAI_MODEL=gpt-5.6-luna

# Enable only after native Firebase App Check is configured in the mobile app.
ENFORCE_APP_CHECK=false
#
# Optional overrides (set as env or in firebase config):
CLAUDE_MODEL=claude-sonnet-4-6
RESET_TZ=Etc/UTC
FUNCTIONS_REGION=europe-west1
